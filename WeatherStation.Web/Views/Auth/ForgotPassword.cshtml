@{
    ViewData["Title"] = "Відновлення пароля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">Забули пароль?</h3>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-info">
                            @ViewBag.Message
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        <p class="text-muted text-center">
                            Введіть ваш email, і ми згенеруємо посилання для безпечного скидання пароля.
                        </p>
                        <div class="mb-3">
                            <label for="email" class="form-label">Ваш Email</label>
                            <input type="email" class="form-control" id="email" name="email"
                                   placeholder="name@example.com" required />
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Отримати посилання</button>
                        </div>
                    </form>
                    
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-decoration-none">Повернутися до входу</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>