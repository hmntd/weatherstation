@{
    ViewData["Title"] = "Встановлення нового пароля";
    var userEmail = Context.Request.Query["email"];
    var resetToken = Context.Request.Query["token"];
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">Створення пароля</h3>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" name="email" value="@userEmail" />
                        <input type="hidden" name="token" value="@resetToken" />

                        <div class="mb-3">
                            <label class="form-label">Акаунт</label>
                            <input type="email" class="form-control" value="@userEmail" disabled />
                        </div>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">Придумайте новий пароль</label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required
                                   minlength="6" />
                            <div class="form-text">Пароль має містити мінімум 6 символів.</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Зберегти та Увійти</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>