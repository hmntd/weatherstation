@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@model List<IdentityUser>

@{
    ViewData["Title"] = "Адмін-панель";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">
    <h2>Панель Адміністратора</h2>
    <p>Керування користувачами системи.</p>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Email / Логін</th>
                <th>Підтверджений?</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><small>@user.Id</small></td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.EmailConfirmed)
                        {
                            <span class="badge bg-success">Так</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Ні</span>
                        }
                    </td>
                    <td>
                        @{
                            var userRolesDict = ViewBag.UserRoles as Dictionary<string, IList<string>>;
                            var roles = userRolesDict != null && userRolesDict.ContainsKey(user.Id)
                                        ? userRolesDict[user.Id]
                                        : new List<string>();
                            bool isAdmin = roles.Contains("Admin");
                        }

                        <div class="d-flex gap-2 align-items-center">
                            @if (isAdmin)
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">User</span>
                            }

                            @if (user.Id != currentUserId)
                            {
                                <form asp-controller="Admin" asp-action="ToggleAdmin" asp-route-id="@user.Id" method="post"
                                      style="display:inline;">
                                    <button type="submit"
                                            class="btn btn-sm @(isAdmin ? "btn-outline-warning" : "btn-outline-success")">
                                        @(isAdmin ? "Зробити юзером" : "Зробити адміном")
                                    </button>
                                </form>

                                <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" method="post"
                                      style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Видалити користувача @user.Email?')">
                                        Видалити
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Це ви</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>