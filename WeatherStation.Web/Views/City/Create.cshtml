@model WeatherStation.BusinessLogic.DTOs.CreateCityDto

@{
    ViewData["Title"] = "Додати місто";
}

<div class="row mt-4">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Додати нове місто</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Назва міста (наприклад, Київ)</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Latitude" class="form-label">Широта (Latitude)</label>
                        <input asp-for="Latitude" type="number" step="any" class="form-control" placeholder="50.4501"
                               required />
                        <span asp-validation-for="Latitude" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Longitude" class="form-label">Довгота (Longitude)</label>
                        <input asp-for="Longitude" type="number" step="any" class="form-control" placeholder="30.5234"
                               required />
                        <span asp-validation-for="Longitude" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Назад</a>
                        <button type="submit" class="btn btn-success">Зберегти</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>