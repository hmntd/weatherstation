@model WeatherStation.BusinessLogic.DTOs.CityDto

@{
    ViewData["Title"] = "Додати місто";
}

<div class="row justify-content-center">
    <div class="col-md-6 mt-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">➕ Додати нове місто</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Назва міста</label>
                        <input asp-for="Name" class="form-control" placeholder="Наприклад: Київ" required />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Latitude" class="form-label">Широта (Latitude)</label>
                        <input asp-for="Latitude" type="number" step="any" class="form-control"
                               placeholder="Наприклад: 50.4500" required />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Longitude" class="form-label">Довгота (Longitude)</label>
                        <input asp-for="Longitude" type="number" step="any" class="form-control"
                               placeholder="Наприклад: 30.5233" required />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
                        <button type="submit" class="btn btn-success">Зберегти місто</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>