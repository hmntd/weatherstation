@model IEnumerable<WeatherStation.BusinessLogic.DTOs.CityDto>

@{
    ViewData["Title"] = "Міста";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>🌍 Відстежувані міста</h2>
    <a asp-action="Create" class="btn btn-primary">➕ Додати місто</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Назва міста</th>
                    <th>Широта</th>
                    <th>Довгота</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            Міст поки немає. Додайте своє перше місто!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var city in Model)
                    {
                        <tr>
                            <td>@city.Id</td>
                            <td><strong>@city.Name</strong></td>
                            <td>@city.Latitude</td>
                            <td>@city.Longitude</td>
                            <td class="text-center">
                                <a asp-controller="WeatherRecord" asp-action="History" asp-route-cityId="@city.Id"
                                       class="btn btn-sm btn-info text-white">
                                    🌤 Погода
                                </a>

                                <a asp-action="Edit" asp-route-id="@city.Id" class="btn btn-sm btn-warning">
                                    ✏️ Редагувати
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>